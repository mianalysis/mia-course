ERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.visualise.overlays.AddTracks" DISABLEABLE="false" ENABLED="true" ID="1694379013734" NAME="Add tracks" NICKNAME="Add tracks" NOTES="Tracks can be rendered in 2D as lines in ImageJ overlays.&#10;&#10;The tracks can be coloured many different ways, but here we'll do it based on the instantaneous velocity of each track (a measurement associated with each &quot;Nuclei&quot; object).&#10;&#10;To prevent the overlay getting too crowded, the &quot;Limit track history&quot; option is enabled.  This only shows tracks from a specified number of most recent frames (here, 10 frames)." SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Colour mode" NICKNAME="Colour mode" SHOW_TEXT="false" VALUE="Instantaneous measurement value" VISIBLE="false"/><PARAMETER NAME="Colour map" NICKNAME="Colour map" SHOW_TEXT="false" VALUE="Spectrum" VISIBLE="false"/><PARAMETER NAME="Single colour" NICKNAME="Single colour" SHOW_TEXT="false" VALUE="White" VISIBLE="false"/><PARAMETER NAME="Child objects for colour" NICKNAME="Child objects for colour" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Measurement for colour" NICKNAME="Measurement for colour" SHOW_TEXT="false" VALUE="TRACK_ANALYSIS // INSTANTANEOUS_SPEED_(µm/FRAME)" VISIBLE="false"/><PARAMETER NAME="Metadata item for colour" NICKNAME="Metadata item for colour" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Parent object for colour" NICKNAME="Parent object for colour" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Partner objects for colour" NICKNAME="Partner objects for colour" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Opacity (%)" NICKNAME="Opacity (%)" VALUE="100.0" VISIBLE="false"/><PARAMETER NAME="Range minimum mode" NICKNAME="Range minimum mode" SHOW_TEXT="false" VALUE="Automatic" VISIBLE="false"/><PARAMETER NAME="Minimum value" NICKNAME="Minimum value" VALUE="0.0" VISIBLE="false"/><PARAMETER NAME="Range maximum mode" NICKNAME="Range maximum mode" SHOW_TEXT="false" VALUE="Automatic" VISIBLE="false"/><PARAMETER NAME="Maximum value" NICKNAME="Maximum value" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Hide objects missing value" NICKNAME="Hide objects missing value" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Input image" NICKNAME="Input image" SHOW_TEXT="false" VALUE="Timeseries" VISIBLE="false"/><PARAMETER NAME="Input objects" NICKNAME="Input objects" SHOW_TEXT="false" VALUE="Tracks" VISIBLE="false"/><PARAMETER NAME="Spot objects" NICKNAME="Spot objects" SHOW_TEXT="false" VALUE="Nuclei" VISIBLE="false"/><PARAMETER NAME="Position mode" NICKNAME="Position mode" SHOW_TEXT="false" VALUE="Object centroid" VISIBLE="false"/><PARAMETER NAME="X-position measurement" NICKNAME="X-position measurement" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Y-position measurement" NICKNAME="Y-position measurement" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Z-position measurement" NICKNAME="Z-position measurement" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Apply to input image" NICKNAME="Apply to input image" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Add output image to workspace" NICKNAME="Add output image to workspace" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Output image" NICKNAME="Output image" VALUE="Overlay" VISIBLE="false"/><PARAMETER NAME="Limit track history" NICKNAME="Limit track history" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Track history (frames)" NICKNAME="Track history (frames)" VALUE="10" VISIBLE="false"/><PARAMETER NAME="Fade out tracks" NICKNAME="Fade out tracks" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Line width" NICKNAME="Line width" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Enable multithreading" NICKNAME="Enable 