t;spatially calibrated&quot; measurements will actually be in pixel units." SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Output image" NICKNAME="Output image" VALUE="Timeseries" VISIBLE="false"/><PARAMETER NAME="Import mode" NICKNAME="Import mode" SHOW_TEXT="false" VALUE="Current file" VISIBLE="false"/><PARAMETER NAME="Reader" NICKNAME="Reader" SHOW_TEXT="false" VALUE="Bio-Formats" VISIBLE="false"/><PARAMETER NAME="Sequence root name" NICKNAME="Sequence root name" VALUE="" VISIBLE="false"/><PARAMETER NAME="Name format" NICKNAME="Name format" SHOW_TEXT="false" VALUE="Generic (from metadata)" VISIBLE="false"/><PARAMETER NAME="Comment" NICKNAME="Comment" VALUE="" VISIBLE="false"/><PARAMETER NAME="Extension" NICKNAME="Extension" VALUE="" VISIBLE="false"/><PARAMETER NAME="Generic format" NICKNAME="Generic format" VALUE="" VISIBLE="false"/><PARAMETER NAME="Available metadata fields" NICKNAME="Available metadata fields" VALUE="" VISIBLE="false"/><PARAMETER NAME="Include series number" NICKNAME="Include series number" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="File path" NICKNAME="File path" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Series mode" NICKNAME="Series mode" SHOW_TEXT="false" VALUE="Current series" VISIBLE="false"/><PARAMETER NAME="Series number" NICKNAME="Series number" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Channels" NICKNAME="Channels" VALUE="1-end" VISIBLE="false"/><PARAMETER NAME="Slices" NICKNAME="Slices" VALUE="1-end" VISIBLE="false"/><PARAMETER NAME="Frames" NICKNAME="Frames" VALUE="1-end" VISIBLE="false"/><PARAMETER NAME="Channel" NICKNAME="Channel" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Crop mode" NICKNAME="Crop mode" SHOW_TEXT="false" VALUE="None" VISIBLE="false"/><PARAMETER NAME="Reference image" NICKNAME="Reference image" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Left coordinate" NICKNAME="Left coordinate" VALUE="0" VISIBLE="false"/><PARAMETER NAME="Top coordinate" NICKNAME="Top coordinate" VALUE="0" VISIBLE="false"/><PARAMETER NAME="Width" NICKNAME="Width" VALUE="512" VISIBLE="false"/><PARAMETER NAME="Height" NICKNAME="Height" VALUE="512" VISIBLE="false"/><PARAMETER NAME="Objects for limits" NICKNAME="Objects for limits" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Scale mode" NICKNAME="Scale mode" SHOW_TEXT="false" VALUE="No scaling" VISIBLE="false"/><PARAMETER NAME="X scale factor" NICKNAME="X scale factor" VALUE="4" VISIBLE="false"/><PARAMETER NAME="Y scale factor" NICKNAME="Y scale factor" VALUE="4" VISIBLE="false"/><PARAMETER NAME="Dimension mismatch mode" NICKNAME="Dimension mismatch mode" SHOW_TEXT="false" VALUE="Disallow (fail upon mismatch)" VISIBLE="false"/><PARAMETER NAME="Pad intensity mode" NICKNAME="Pad intensity mode" SHOW_TEXT="false" VALUE="Black (0)" VISIBLE="false"/><PARAMETER NAME="Set manual spatial calibration" NICKNAME="Set manual spatial calibration" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="XY calibration (dist/px)" NICKNAME="XY calibration (dist/px)" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Z calibration (dist/px)" NICKNAME="Z calibration (dist/px)" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Set manual temporal calibration" NICKNAME="Set manual temporal calibration" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Frame interval (time/frame)" NICKNAME="Frame interval (time/frame)" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Force bit depth" NICKNAME="Force bit depth" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Output bit depth" NICKNAME="Output bit depth" SHOW_TEXT="false" VALUE="8" VISIBLE="false"/><PARAMETER NAME="Minimum input intensity" NICKNAME="Minimum input intensity" VALUE="0.0" VISIBLE="false"/><PARAMETER NAME="Maximum input intensity" NICKNAME="Maximum input intensity" VALUE="1.0" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MOD